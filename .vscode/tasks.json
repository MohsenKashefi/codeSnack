{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "gradle: Build Debug APK",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew.bat",
            "args": [
                "assembleDebug"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "gradle: Build and Install Debug",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew.bat",
            "args": [
                "installDebug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "gradle: Run App on Device",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew.bat",
            "args": [
                "installDebug"
            ],
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [],
            "dependsOn": "gradle: Build Debug APK"
        },
        {
            "label": "gradle: Clean Build",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew.bat",
            "args": [
                "clean"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "adb: Start Activity",
            "type": "shell",
            "command": "C:\\Users\\Mohsen\\AppData\\Local\\Android\\Sdk\\platform-tools\\adb.exe",
            "args": [
                "shell",
                "am",
                "start",
                "-n",
                "com.example.codesnack/.MainActivity"
            ],
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "adb: Install APK",
            "type": "shell",
            "command": "C:\\Users\\Mohsen\\AppData\\Local\\Android\\Sdk\\platform-tools\\adb.exe",
            "args": [
                "install",
                "-r",
                "${workspaceFolder}/app/build/outputs/apk/debug/app-debug.apk"
            ],
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [],
            "dependsOn": "gradle: Build Debug APK"
        },
        {
            "label": "Android: Build, Install & Run",
            "dependsOrder": "sequence",
            "dependsOn": [
                "gradle: Build and Install Debug",
                "adb: Start Activity"
            ],
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
