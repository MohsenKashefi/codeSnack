<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Main dark background with rounded corners (matching dark theme) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E1E1E" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- === TOP SECTION: Language and Category Badges === -->

    <!-- Kotlin badge (purple, top left) -->
    <item
        android:left="16dp"
        android:top="16dp"
        android:width="60dp"
        android:height="24dp">
        <shape android:shape="rectangle">
            <solid android:color="#7F52FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- "Best Practice" category badge (gray, top right) -->
    <item
        android:right="16dp"
        android:top="16dp"
        android:width="100dp"
        android:height="24dp">
        <shape android:shape="rectangle">
            <solid android:color="#37474F" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- === TITLE SECTION === -->

    <!-- Title line 1 (light gray bar simulating "Use Data Classes") -->
    <item
        android:left="16dp"
        android:right="90dp"
        android:top="52dp"
        android:height="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#E0E0E0" />
            <corners android:radius="3dp" />
        </shape>
    </item>

    <!-- Title line 2 (shorter, for wrapped title) -->
